
config storage 'storage'
	# Where states are persisted. Every apply writes the state here, so
	# consider external storage (e.g. '/mnt/usb/terraform') over the flash.
	# Only the default directory is kept across sysupgrade.
	option state_dir '/etc/terraform'
	# Where locks are kept. Keep this on tmpfs.
	option lock_dir '/var/run/terraform'
	# Largest accepted state, in bytes or with a K or M suffix.
	option max_state_size '16M'

config auth 'auth'
	# Require the credentials of a user (see below). When disabled, anyone who
	# can reach the router can read and overwrite states, which often contain
	# secrets: only do this on a trusted network.
	option enabled '1'
	# Also serve requests over plain HTTP. Passwords and states then cross the
	# network unencrypted: only enable this behind a proxy terminating TLS.
	option allow_http '0'

# Clients authenticate as users, created with random passwords by
# terraform-backend-user (e.g. 'terraform-backend-user add ci home'):
#
# config user 'ci'
#	option password 'sha256$<salt>$<hex sha256 of salt + password>'
#	# The workspaces the user may access; all of them if not set.
#	list workspace 'home'
