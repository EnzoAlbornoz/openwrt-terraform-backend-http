{
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.codeActionsOnSave": {
        "source.fixAll.oxc": "always"
    },
    "oxc.useExecPath": true,
    "oxc.path.oxfmt": "packages/handler/node_modules/oxfmt/bin/oxfmt",
    "oxc.path.oxlint": "packages/handler/node_modules/oxlint/bin/oxlint",
    "github.copilot.chat.commitMessageGeneration.instructions": [
        {
            "file": ".copilot-commit-message-instructions.md"
        },
        {
            "text": "Use conventional commit message format. Do not stack multiple types in a single commit message, merge them into a single coherent message."
        }
    ]
}
